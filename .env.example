# ─────────────────────────────────────────────────────────────────────────
# darso — environment variables
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase Dashboard → Project Settings → API  (URL + keys)
#   Supabase Dashboard → Project Settings → Database  (connection string)
# `.env` is git-ignored; never commit real keys.
# ─────────────────────────────────────────────────────────────────────────

# ── Supabase: client (browser-safe, exposed to the bundle) ───────────────
# Project API URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon / publishable key (safe to expose; RLS enforces access).
# Dashboard → API → "anon public"  (or the new "Publishable key", sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase: server-only (NEVER expose to the browser) ──────────────────
# Service-role / secret key. Bypasses RLS — use only in server code
# (route handlers, server actions, cron). Dashboard → API → "service_role"
# (or the new "Secret key", sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=

# ── Database connection (for running migrations / the Supabase CLI) ───────
# Dashboard → Database → Connection string → URI (use the pooled 6543 port
# for serverless, or 5432 for direct/migrations). Server-only.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ── App ──────────────────────────────────────────────────────────────────
# Canonical site URL, used for auth redirect callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
